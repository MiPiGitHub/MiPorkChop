[Unit]
Description=MiPorkChop switch and LED
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miporkchop
RuntimeDirectory=miporkchop
WorkingDirectory=/run/miporkchop
EnvironmentFile=-/etc/miporkchop.env
ExecStart=/usr/bin/python3 -u /opt/miporkchop/porkchop.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
